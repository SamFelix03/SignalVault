# Copy to .env — you only need vault address(es) + publisher wallet key.

# Binary (event-contract) vault from the deploy UI
VAULT_ADDRESS=0xYourBinaryVaultAddress

# Perp vault (required when running with --instrument perp)
PERP_VAULT_ADDRESS=0xYourPerpVaultAddress

# Required — same wallet that deployed the vault (already authorized as publisher)
PRIVATE_KEY=0xYourDeployerPrivateKey

# Required — Somnia markets indexer GraphQL endpoint
MARKETS_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Optional
RPC_URL=https://api.infra.testnet.somnia.network/
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INTERVAL_MS=300000

# Default instrument when no CLI flag (overridden by --instrument binary|perp)
# INSTRUMENT=binary

# Market selection
# MARKET_ASSET=ETH   # binary default
# MARKET_ASSET=XRP   # perp default (smaller min lot on testnet)

# Inference: "rules" = same rule engine as native AgentOrchestrator fallback
#            "llm"    = Groq tool-call — needs GROQ_API_KEY
INFERENCE_MODE=rules

# Publish every pipeline run even if direction/size unchanged (for pay-per-signal testing)
# FORCE_PUBLISH=1
