# Copy to .env and fill in after deploying a custom vault from http://localhost:3000/deploy

# Required — vault address from the deploy UI (setup screen or /vault/0x... URL)
VAULT_ADDRESS=0xYourVaultAddress

# Required — same wallet that deployed the vault (already authorized as publisher)
PRIVATE_KEY=0xYourDeployerPrivateKey

# Optional
RPC_URL=https://api.infra.testnet.somnia.network/
INTERVAL_MS=300000

# Inference: "rules" = same rule engine as native AgentOrchestrator fallback
#            "llm"    = Groq tool-call (mirrors on-chain LLM infer stage) — needs GROQ_API_KEY
INFERENCE_MODE=rules

# Groq LLM inference (optional — stage 5 parity with native pipeline)
# Get a free key at https://console.groq.com
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Set to 0 to only publish signals (skip subscribe + dreamDEX adapter funding)
ENABLE_DREAMDEX=0

# dreamDEX options (when ENABLE_DREAMDEX=1)
# QUOTE_DEPOSIT_USD=100
# BASE_DEPOSIT_ETH=0
# MAX_POSITION_ETH=0.05
# RISK_PCT=1000
# MAX_SLIPPAGE_BPS=300
# STOP_LOSS_BUFFER_ETH=0.01
