{
  "name": "signalvault-sdk",
  "version": "0.3.0",
  "description": "Publish binary and perp signals to SignalVault vaults on Somnia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalvault",
    "somnia",
    "defi",
    "trading-signals"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "~2.37.8"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@somnia-chain/markets-sdk": ">=0.28.0"
  },
  "peerDependenciesMeta": {
    "@somnia-chain/markets-sdk": {
      "optional": true
    }
  }
}
