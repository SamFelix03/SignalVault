# ── Ports (frontend and backend MUST be different) ──────────────────
# frontend/.env
#   FRONTEND_PORT=3001               # Next.js dev server
#   NEXT_PUBLIC_BACKEND_PORT=3002    # where the Express API runs
# backend/.env
#   BACKEND_PORT=3002                # Express API server
#
# Example combos:
#   Frontend 3000 + Backend 3001  →  FRONTEND_PORT=3000, NEXT_PUBLIC_BACKEND_PORT=3001
#   Frontend 3001 + Backend 3002  →  FRONTEND_PORT=3001, NEXT_PUBLIC_BACKEND_PORT=3002

# Somnia Testnet Configuration
RPC_URL=https://api.infra.testnet.somnia.network/
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
CHAIN_ID=50312
EXPLORER_URL=https://shannon-explorer.somnia.network/

# Deployer / Publisher wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

