# ── Telegram vault alerts (backend) ─────────────────────────────────
# Create bot via @BotFather. Users connect via "Open in Telegram" deep link (no Login Widget needed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_ENABLED=1
FRONTEND_PUBLIC_URL=http://localhost:3000

# Supabase (backend only — never expose service role to frontend)
# Run backend/supabase/telegram-alerts.sql in Supabase SQL Editor first
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend (.env): NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# ── Pay-per-signal (SVT ERC-20) ─────────────────────────────────────
# Deploy SignalPayToken via contracts/script/deploy.sh, then set:
# NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xe5BAfDbe82f30507BB54C1f0007e7062b78eB32e  (frontend/.env)
