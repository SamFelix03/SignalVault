    "@types/node": "^25.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "viem": "~2.37.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
