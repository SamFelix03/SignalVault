# Backend API port (must differ from the frontend PORT)
BACKEND_PORT=3002

# Somnia Testnet
RPC_URL=https://api.infra.testnet.somnia.network/
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Deployer / publisher wallet (required for stream publisher + pipeline trigger)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contracts (optional — defaults to demo deployment addresses)
VAULT_FACTORY_ADDRESS=0x14ac542754707570A5924aF77e978Af97ab52FFF
LEGACY_VAULT_FACTORY_ADDRESS=0x9A4f07DE4Bb41F4792a397Bc1ef35Bed60484101
EXTRA_VAULT_FACTORY_ADDRESSES=0xf0e1E3012DE65F388bc68cf587858C2d738dE0a3,0xDB8529BEc20D34322849eE63cD5D8D02eF23d76C
# tUSDC — signal fees and Event Contract collateral (Somnia testnet)
PAYMENT_TOKEN_ADDRESS=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
MARKETS_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# RELAYER_PRIVATE_KEY — same wallet as PRIVATE_KEY for wallet-tracked vault relayer
